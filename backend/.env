# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb+srv://indhirasanthini:indhirasanthini@cluster0.kfvd3i8.mongodb.net/car_rental?retryWrites=true&w=majority
MONGODB_TEST_URI=mongodb://localhost:27017/car_rental_test

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production_minimum_32_characters
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this_in_production
JWT_REFRESH_EXPIRE=7d

# Email Configuration (SendGrid or NodeMailer)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
SENDGRID_API_KEY=your_sendgrid_api_key

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# Frontend Configuration
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
